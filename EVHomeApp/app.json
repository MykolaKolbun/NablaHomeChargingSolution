{
  "expo": {
    "name": "Nabla Home",
    "slug": "EVHomeApp",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ua.alternatiview.nablahome"
    },
    "android": {
      "package": "ua.alternatiview.nablahome",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F1117"
      },
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0F1117"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2EE89E",
          "defaultChannel": "charging"
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://home-api.alternatiview.com.ua",
      "devTools": true
    }
  }
}
